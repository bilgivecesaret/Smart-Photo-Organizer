<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/fragment_settings">

    <TextView
        android:id="@+id/textView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        android:text="@string/title_settings"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="20dp">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/permissionSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:checked="true"
            android:maxWidth="320dp"
            android:layout_gravity="center_horizontal"
            android:text="Permissions"
            android:textSize="20sp" />


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutline">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Başlık -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto Cleanup"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:paddingBottom="8dp"/>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="?attr/colorOutlineVariant"
                    android:layout_marginBottom="8dp"/>

                <!-- Girintili Switch 1 -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoCleanupForSimilarImagesSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Similar Photos"
                    android:textSize="18sp"
                    android:paddingStart="24dp"
                    android:paddingVertical="8dp"/>

                <!-- Girintili Switch 2 -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/autoCleanupForBlurredImagesSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blurred Photos"
                    android:textSize="18sp"
                    android:paddingStart="24dp"
                    android:paddingVertical="8dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/autoAlbumSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:maxWidth="320dp"
            android:layout_gravity="center_horizontal"
            android:checked="false"
            android:text="Auto create album"
            android:textSize="20sp" />

    </LinearLayout>


</LinearLayout>